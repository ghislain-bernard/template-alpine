{
  "author": "Ghislain Bernard <ghislain.bernard@gmail.com>",
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@parcel/config-default": "2.16.4",
    "@parcel/core": "2.16.4",
    "@parcel/optimizer-htmlnano": "2.16.4",
    "@parcel/optimizer-terser": "2.16.4",
    "@parcel/transformer-pug": "2.16.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/alpinejs": "3.17.0",
    "@types/node": "26.6.5",
    "alpinejs": "3.17.4",
    "by-node-env": "2.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "htmlhint": "1.9.2",
    "material-icons": "1.13.14",
    "parcel": "2.16.4",
    "postcss": "8.5.31",
    "postcss-nested": "7.0.2",
    "rimraf": "6.1.3",
    "sharp": "0.33.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "description": "template",
  "license": "MIT",
  "name": "@gbernard/template-alpine",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "by-node-env",
    "build:development": "parcel build --no-autoinstall --no-optimize --no-source-maps",
    "build:production": "parcel build --no-autoinstall --no-source-maps",
    "clean": "rimraf .parcel-cache dist",
    "lint": "eslint --max-warnings=0 src/script.ts",
    "postbuild": "rimraf .parcel-cache",
    "prebuild": "rimraf .parcel-cache dist",
    "prestart": "rimraf .parcel-cache dist",
    "start": "by-node-env",
    "start:development": "parcel serve --no-autoinstall",
    "start:production": "parcel watch --no-autoinstall --no-hmr --no-source-maps",
    "version": "echo $npm_package_version"
  },
  "source": "src/index.pug",
  "type": "module",
  "version": "0.0.1"
}
